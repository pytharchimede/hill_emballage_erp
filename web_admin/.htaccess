<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /hill/web_admin/

  # Rediriger toute requête *.html vers *.php s'il existe
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)\.html$ $1.php [L,QSA]

  # Fallback vers index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  # Content Security Policy: pas de scripts inline; autoriser nos fichiers et les CDNs utilisés
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: blob: https://cdn.jsdelivr.net https://*.tile.openstreetmap.org; connect-src 'self'; font-src 'self' https://cdnjs.cloudflare.com data:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; script-src 'self' https://cdn.jsdelivr.net https://code.jquery.com"
  # Désactiver sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # XSS Protection (héritage)
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>
